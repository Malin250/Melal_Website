{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "install",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"label": "npm: install",
			"detail": "install dependencies from package"
		},
		{
			"label": "Build React app",
			"type": "shell",
			"command": "npm run build",
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Start backend API",
			"type": "shell",
			"command": "npm run server",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Start frontend dev server",
			"type": "shell",
			"command": "npm run dev -- --host 0.0.0.0 --port 4173",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}